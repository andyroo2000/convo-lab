BACKUP_BUCKET=convolab-db-backups
BACKUP_PREFIX=daily
BACKUP_DIR=/opt/convolab-data/backups/postgres
GCS_SERVICE_ACCOUNT_FILE=/opt/convolab-runtime/secrets/gcloud-key.json
LOCAL_RETENTION_DAYS=2
POSTGRES_CONTAINER=convolab-postgres
POSTGRES_USER=languageflow
POSTGRES_DATABASES="languageflow learning_os"

# Optional Healthchecks.io-style ping URL. The backup sends /start, /fail, and
# success pings when this value is set.
HEALTHCHECK_URL=
